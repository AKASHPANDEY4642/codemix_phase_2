# =============================================================================
# MedManglish-RAG Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual keys.
# NEVER commit .env to version control.

# Groq API Key (Free tier: https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# OpenAI API Key (Optional — for API-offloaded embeddings)
OPENAI_API_KEY=sk-your_openai_key_here

# HuggingFace Token (for gated models like Gemma-2, IndicTrans2)
HF_TOKEN=hf_your_huggingface_token_here

# UMLS API Key (Free: https://uts.nlm.nih.gov/uts/)
UMLS_API_KEY=your_umls_api_key_here
